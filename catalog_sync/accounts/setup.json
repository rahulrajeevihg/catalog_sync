          "permlevel": 2
        },
        {
          "fieldname": "workflow_state",
          "label": "Approval state",
          "fieldtype": "Link",
          "options": "Workflow State",
          "default": "Registered",
          "in_list_view": 1,
          "read_only": 1
        },
        {
          "fieldname": "review_notes",
          "label": "Message to applicant",
          "fieldtype": "Small Text",
          "description": "Shown to the applicant. Use internal notes for private staff remarks.",
