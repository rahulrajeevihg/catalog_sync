      "title_field": "display_name",
      "search_fields": "email,organisation_name,phone_e164",
      "sort_field": "modified",
      "sort_order": "DESC"
    },
    {
      "doctype": "Workflow",
      "workflow_name": "Catalogue Account Approval",
      "document_type": "Catalogue Account",
      "is_active": 1,
      "workflow_state_field": "workflow_state",
      "states": [
        {
          "state": "Registered",
          "doc_status": "0",
          "allow_edit": "Catalogue Account Editor"
        },
        {
          "state": "Pending Review",
          "doc_status": "0",
          "allow_edit": "Catalogue Account Editor"
        },
        {
          "state": "Approved Trader",
          "doc_status": "0",
          "allow_edit": "Catalogue Account Editor"
        },
        {
          "state": "Rejected",
          "doc_status": "0",
          "allow_edit": "Catalogue Account Editor"
        },
        {
          "state": "Suspended",
          "doc_status": "0",
          "allow_edit": "Catalogue Account Editor"
        }
      ],
      "transitions": [
        {
          "state": "Registered",
          "action": "Submit application",
          "next_state": "Pending Review",
          "allowed": "Catalogue Account Integration",
          "condition": "doc.trader_requested and doc.email_verified and doc.documents_ready and not doc.website_disabled and doc.organisation_name and doc.proof_1",
          "allow_self_approval": 1
        },
        {
          "state": "Approved Trader",
          "action": "Resubmit application",
          "next_state": "Pending Review",
          "allowed": "Catalogue Account Integration",
          "condition": "doc.trader_requested",
          "allow_self_approval": 1
        },
        {
          "state": "Rejected",
          "action": "Resubmit application",
          "next_state": "Pending Review",
          "allowed": "Catalogue Account Integration",
          "condition": "doc.trader_requested",
          "allow_self_approval": 1
        },
        {
          "state": "Pending Review",
          "action": "Withdraw application",
          "next_state": "Registered",
          "allowed": "Catalogue Account Integration",
          "condition": "not doc.trader_requested",
          "allow_self_approval": 1
        },
        {
          "state": "Approved Trader",
          "action": "Withdraw application",
          "next_state": "Registered",
          "allowed": "Catalogue Account Integration",
          "condition": "not doc.trader_requested",
          "allow_self_approval": 1
        },
        {
          "state": "Rejected",
          "action": "Withdraw application",
          "next_state": "Registered",
          "allowed": "Catalogue Account Integration",
          "condition": "not doc.trader_requested",
          "allow_self_approval": 1
        },
        {
          "state": "Pending Review",
          "action": "Approve",
          "next_state": "Approved Trader",
          "allowed": "Catalogue Trader Approver",
          "condition": "doc.trader_requested and doc.email_verified and doc.documents_ready and not doc.website_disabled and doc.organisation_name and doc.proof_1",
          "allow_self_approval": 1
        },
        {
          "state": "Pending Review",
          "action": "Reject",
          "next_state": "Rejected",
          "allowed": "Catalogue Trader Approver",
          "condition": "doc.review_notes",
          "allow_self_approval": 1
        },
        {
          "state": "Approved Trader",
          "action": "Suspend",
          "next_state": "Suspended",
          "allowed": "Catalogue Trader Approver",
          "condition": "",
          "allow_self_approval": 1
        },
        {
          "state": "Suspended",
          "action": "Reactivate",
          "next_state": "Approved Trader",
          "allowed": "Catalogue Trader Approver",
          "condition": "doc.trader_requested and doc.email_verified and doc.documents_ready and not doc.website_disabled and doc.organisation_name and doc.proof_1",
          "allow_self_approval": 1
        }
      ],
      "send_email_alert": 0
    },
    {
      "doctype": "Workspace",
      "name": "Website Accounts",
      "label": "Website Accounts",
      "title": "Website Accounts",
      "public": 1,
      "module": "Custom",
      "roles": [
        {
          "role": "Catalogue Trader Approver"
        }
      ],
      "content": "[{\"id\": \"catalogue-shortcuts\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Website Accounts\", \"col\": 6}}, {\"id\": \"catalogue-traders\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Traders\", \"col\": 6}}]",
      "shortcuts": [
        {
          "label": "Website Accounts",
          "type": "DocType",
          "link_to": "Catalogue Account",
          "doc_view": "List",
          "color": "Grey"
        },
        {
          "label": "Traders",
          "type": "URL",
          "color": "Orange",
          "stats_filter": "[[\"Catalogue Account\", \"trader_requested\", \"=\", 1]]",
          "url": "/app/catalogue-account?trader_requested=1"
        }
      ]
    }
  ]
